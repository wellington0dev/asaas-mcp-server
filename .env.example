# Asaas API Configuration
# Get your API key from: https://www.asaas.com/minha-conta/api
# Sandbox: https://sandbox.asaas.com/minha-conta/api

# Required: Your Asaas API Key
ASAAS_API_KEY=your_asaas_api_key_here

# Optional: API URL (defaults to sandbox)
# Production: https://api.asaas.com/v3
# Sandbox: https://api-sandbox.asaas.com/v3
ASAAS_API_URL=https://api-sandbox.asaas.com/v3

# Optional: Webhook authentication token for validating incoming webhooks
# Generate a secure random string (min 32 chars)
# ASAAS_WEBHOOK_AUTH_TOKEN=your_secure_webhook_token_here

# Optional: Logging level (fatal, error, warn, info, debug, trace)
LOG_LEVEL=info

# Optional: HTTP client settings
HTTP_TIMEOUT_MS=30000
HTTP_MAX_RETRIES=3
HTTP_RETRY_DELAY_MS=1000